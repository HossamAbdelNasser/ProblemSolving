class Solution {
public:
    string smallestPalindrome(string s) {

        int n = s.length();
        int half = n / 2;
        string mid = n % 2 != 0 ? string(1, s[half]) : "";
        string left, right;

        for (int i = 0; i < n/2; i++) {
            left += s[i];
        }

        sort(left.begin(), left.end());
        right = left;
        reverse(right.begin(), right.end());

        return left + mid + right;
    }
};
