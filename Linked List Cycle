/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */

//Hash set solution
class Solution {
public:
    bool hasCycle(ListNode *head) {

        ListNode *temp = head;
        unordered_set<ListNode*> s;

        while (temp) {

            auto it = s.find(temp);

            if (it != s.end()) {
                return true;
    } else {
          s.insert(temp);
            temp = temp->next;
    }
        }
        return false;
    }
};

